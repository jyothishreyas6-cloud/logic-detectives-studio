  {
   "i": 16,
   "who": "N",
   "voice": "narrator",
   "text": "Pause and think.",
   "wpm": 145
  },
  {
   "i": 17,
   "who": "N",
   "voice": "narrator",
   "text": "You can see small groups without counting.",
   "wpm": 145
  },
  {
   "i": 18,
   "who": "N",
   "voice": "narrator",
   "text": "Two dots on this wing.",
   "wpm": 145
