   "who": "N",
   "voice": "narrator",
   "text": "Touch each dot only once.",
   "wpm": 145
  },
  {
   "i": 25,
   "who": "N",
   "voice": "narrator",
   "text": "One, two, three, four.",
   "wpm": 145
  },
  {
   "i": 26,
