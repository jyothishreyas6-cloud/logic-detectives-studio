   "text": "At a glance means one quick look.",
   "wpm": 145
  },
  {
   "i": 5,
   "who": "N",
   "voice": "narrator",
   "text": "Like the dots on a dice.",
   "wpm": 145
  },
  {
   "i": 6,
   "who": "N",
   "voice": "narrator",
   "text": "Mabel painted this ladybird stepping stone.",
   "wpm": 145
