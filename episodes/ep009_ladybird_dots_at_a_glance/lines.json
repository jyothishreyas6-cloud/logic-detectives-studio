   "voice": "narrator",
   "text": "Two and two make four.",
   "wpm": 145
  },
  {
   "i": 21,
   "who": "N",
   "voice": "narrator",
   "text": "It's B! Four dots.",
   "wpm": 145
  },
  {
   "i": 22,
   "who": "O",
   "voice": "otto",
   "text": "Oh! I touched one dot twice!",
   "wpm": 145
  },
  {
   "i": 23,
   "who": "B",
   "voice": "bramble",
   "text": "Let's check another way.",
   "wpm": 145
  },
  {
